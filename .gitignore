# --- Training outputs (large checkpoints / logs / metrics) ---
# Outputs land under outputs/ by default. Keep legacy log directories ignored too,
# so a training run never gets pushed to the repository.
log_scale_*/
log/
outputs/

# --- Python runtime cache ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# --- Misc ---
.DS_Store
*.tmp
nohup.out

# --- Locally generated quickstart images ---
# Not shipped: the source-image terms in LICENSES.md must be checked first.
examples/


# Model artifacts are distributed through Hugging Face.
*.pt
*.pth
*.ckpt
*.safetensors

# Reconstructed evaluation data and raw source downloads (keep outside the repo).
micropool-eval/
*.part

# Local maintenance notes and optional example-generation helper.
/docs/README.md
/REPRODUCIBILITY_AUDIT.md
/scripts/make_examples.sh
